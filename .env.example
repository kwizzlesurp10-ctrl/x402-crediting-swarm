# Gemini (AI SDK @ai-sdk/google)
GOOGLE_GENERATIVE_AI_API_KEY=

# x402 seller
# Same payTo as x402-mcp. Override if this swarm should settle elsewhere.
X402_PAY_TO_ADDRESS=0x8A897D546c22d726b45Fa25F0EBB56207E63fF4e

X402_EVAL_PRICE=$0.05

# Leave X402_NETWORK / X402_FACILITATOR_URL unset to auto-select:
#   CDP keys present  → Base mainnet (eip155:8453) + CDP facilitator
#   X402_NETWORK=eip155:8453 without CDP → PayAI public facilitator
#   otherwise         → Base Sepolia (eip155:84532) + https://x402.org/facilitator
# x402scan / AgentCash listings require Base mainnet (not Sepolia).
# X402_NETWORK=eip155:8453
# X402_FACILITATOR_URL=https://facilitator.payai.network

# Mainnet settlement (never commit secrets). Same keys as x402-mcp.
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=

# Operator AgentCash wallet lives at ~/.agentcash/wallet.json.
# This swarm uses the x402-mcp hot buyer (0xc22c17Fca624dB679B2471f2Bb099E1E29a46209).
# Never put that spend key on Railway — seller host is payTo-only.
# Fund: https://agentcash.dev/deposit/0xc22c17Fca624dB679B2471f2Bb099E1E29a46209?network=base

# Public origin agents hit (OpenAPI servers.url / 402 resource URL).
# Required on Docker/Railway: Next standalone otherwise advertises 0.0.0.0:PORT.
# BASE_URL=https://your-production-host
# PUBLIC_ORIGIN=https://your-production-host

# MPP (optional second rail). MPP_OPERATOR_KEY address must equal X402_PAY_TO_ADDRESS.
# MPP_SECRET_KEY=
# MPP_CURRENCY=0x20c000000000000000000000b9537d11c60e8b50
# MPP_OPERATOR_KEY=
